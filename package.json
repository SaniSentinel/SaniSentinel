{
  "name": "react-vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup-db": "node scripts/setup-database-direct.js",
    "setup-db-full": "node scripts/setup-database-with-facilities.js",
    "create-test-users": "node scripts/create-test-users.js",
    "update-user-metadata": "node scripts/update-user-metadata.js",
    "test:rls-officer-facilities": "node scripts/test-rls-facilities-officer.mjs",
    "test:role-separation": "node scripts/test-role-separation-e2e.mjs",
    "test:inbound-sms": "node scripts/test-inbound-sms-e2e.mjs",
    "test:sms-roundtrip": "node scripts/test-sms-roundtrip-e2e.mjs",
    "test:flood-event": "node scripts/test-flood-event-e2e.mjs",
    "test:realtime-alerts": "node scripts/test-realtime-alerts-e2e.mjs",
    "test:outbound-sms": "node scripts/test-outbound-sms-flow.mjs",
    "deploy:inbound-sms": "npx --yes supabase@latest functions deploy inbound-sms",
    "deploy:send-sms-alert": "npx --yes supabase@latest functions deploy send-sms-alert",
    "deploy:ussd-wash": "npx --yes supabase@latest functions deploy ussd-wash",
    "deploy:telecom": "npm run deploy:inbound-sms && npm run deploy:send-sms-alert && npm run deploy:ussd-wash"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "africastalking": "^0.6.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.6.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "terser": "^5.47.1",
    "vite": "^5.0.8"
  }
}
